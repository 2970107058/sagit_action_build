CONFIG_ENV=config.env
#内核源地址
KERNEL_SOURCE=https://github.com/xiaomi-msm8998-devs/android_kernel_xiaomi_msm8998
#分支
KERNEL_SOURCE_BRANCH=lineage-23.2
#内核配置文件
KERNEL_CONFIG=mi8998_defconfig

#KernelSU相关，默认开启。
ENABLE_KERNELSU=true

#这块几乎可以不动，KERNEL_IMAGE_NAME可能的取值有Image.gz-dtb,Image.gz,Image等
KERNEL_IMAGE_NAME=Image.gz-dtb

# Configuration
DISABLE_LTO=true
DISABLE_CC_WERROR=true
